#!/usr/bin/env python3
"""Gate teleop cmd_vel behind /teleop_active; toggle Start/Back; Nav2 lifecycle cutover."""
from collections.abc import Callable

import rclpy
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.executors import MultiThreadedExecutor
from rclpy.node import Node
from geometry_msgs.msg import Twist
from lifecycle_msgs.msg import Transition
from lifecycle_msgs.srv import ChangeState
from nav2_msgs.srv import ManageLifecycleNodes
from sensor_msgs.msg import Joy
from std_msgs.msg import Bool
from std_srvs.srv import Trigger


class TeleopNavGate(Node):
    def __init__(self) -> None:
        self._cbg = ReentrantCallbackGroup()
        super().__init__("teleop_nav_gate")

        self.declare_parameter("start_button", 7)
        self.declare_parameter("back_button", 6)
        self.declare_parameter("teleop_cmd_vel_in", "/teleop_cmd_vel_raw")
        self.declare_parameter("cmd_vel_out", "/cmd_vel")
        self.declare_parameter("teleop_active_out", "/teleop_active")
        self.declare_parameter(
            "nav2_lifecycle_nodes",
            [
                "controller_server",
                "planner_server",
                "behavior_server",
                "bt_navigator",
                "waypoint_follower",
                "smoother_server",
                "velocity_smoother",
            ],
        )
        self.declare_parameter("nav2_manager", "/lifecycle_manager_navigation/manage_nodes")

        self._start_i = self.get_parameter("start_button").get_parameter_value().integer_value
        self._back_i = self.get_parameter("back_button").get_parameter_value().integer_value
        topic_in = self.get_parameter("teleop_cmd_vel_in").get_parameter_value().string_value
        topic_out = self.get_parameter("cmd_vel_out").get_parameter_value().string_value
        active_out = self.get_parameter("teleop_active_out").get_parameter_value().string_value
        self._nav_nodes = list(
            self.get_parameter("nav2_lifecycle_nodes").get_parameter_value().string_array_value
        )
        self._nav2_manager_srv = (
            self.get_parameter("nav2_manager").get_parameter_value().string_value
        )

        self._teleop_active = False
        self._prev_start = False
        self._prev_back = False
        self._mode_busy = False
        self._nav2_game_over = False
        self._arm_timer = None
        self._disarm_timer = None
        self._lifecycle_clients: dict[str, object] = {}
        self._nav2_manager_client = None

        self._pub_cmd = self.create_publisher(Twist, topic_out, 10)
        self._pub_active = self.create_publisher(Bool, active_out, 10)
        self.create_subscription(Joy, "/joy", self._on_joy, 10, callback_group=self._cbg)
        self.create_subscription(Twist, topic_in, self._on_twist, 10, callback_group=self._cbg)

        self.create_service(Trigger, "arm", self._srv_arm, callback_group=self._cbg)
        self.create_service(Trigger, "disarm", self._srv_disarm, callback_group=self._cbg)

        self._pub_active.publish(Bool(data=False))
        self.get_logger().info(
            f"teleop_nav_gate: Start btn {self._start_i}, Back {self._back_i}; "
            f"Nav2 lifecycle targets {self._nav_nodes}; "
            f"Nav2 manager {self._nav2_manager_srv}"
        )

    def _get_client(self, node_name: str):
        if node_name not in self._lifecycle_clients:
            self._lifecycle_clients[node_name] = self.create_client(
                ChangeState, f"/{node_name}/change_state"
            )
        return self._lifecycle_clients[node_name]

    def _get_nav2_manager_client(self):
        if self._nav2_manager_client is None:
            self._nav2_manager_client = self.create_client(
                ManageLifecycleNodes, self._nav2_manager_srv
            )
        return self._nav2_manager_client

    def _shutdown_nav2_via_manager_async(self, done: Callable[[bool], None]) -> None:
        cli = self._get_nav2_manager_client()
        if not cli.service_is_ready():
            if not cli.wait_for_service(timeout_sec=0.2):
                self.get_logger().warning(
                    f"No service {self._nav2_manager_srv} — cannot shutdown Nav2 via manager"
                )
                done(False)
                return
        req = ManageLifecycleNodes.Request()
        req.command = ManageLifecycleNodes.Request.SHUTDOWN
        future = cli.call_async(req)

        def _cb(fut) -> None:
            try:
                resp = fut.result()
                ok = resp is not None and bool(getattr(resp, "success", False))
                if not ok:
                    self.get_logger().warning(
                        f"Nav2 manager shutdown returned success={getattr(resp, 'success', None)}"
                    )
                done(ok)
            except Exception as exc:  # noqa: BLE001
                self.get_logger().warning(f"Nav2 manager shutdown error: {exc}")
                done(False)

        future.add_done_callback(_cb)

    def _call_transition_async(
        self,
        node_name: str,
        transition_id: int,
        done: Callable[[bool], None],
    ) -> None:
        cli = self._get_client(node_name)
        if not cli.service_is_ready():
            if not cli.wait_for_service(timeout_sec=0.05):
                self.get_logger().warning(
                    f"No service /{node_name}/change_state — skip (teleop-only or Nav2 not up)"
                )
                done(False)
                return
        req = ChangeState.Request()
        req.transition.id = transition_id
        future = cli.call_async(req)

        def _cb(fut) -> None:
            try:
                resp = fut.result()
                ok = resp is not None and resp.success
                if not ok:
                    self.get_logger().warning(
                        f"{node_name} change_state id={transition_id} "
                        f"success={getattr(resp, 'success', None)}"
                    )
                done(ok)
            except Exception as exc:  # noqa: BLE001
                self.get_logger().warning(f"{node_name} change_state error: {exc}")
                done(False)

        future.add_done_callback(_cb)

    def _run_transition_chain(
        self, transition_id: int, finished: Callable[[], None]
    ) -> None:
        names = list(reversed(self._nav_nodes))
        any_ok = False

        def step(i: int, prev_ok: bool) -> None:
            nonlocal any_ok
            if prev_ok:
                any_ok = True
            if i >= len(names):
                if self._nav_nodes and not any_ok:
                    self.get_logger().warning(
                        "Nav2 lifecycle transition did not apply (nodes not running yet?). "
                        "If Nav2 starts later, press Start again to re-apply shutdown."
                    )
                finished()
                return

            self._call_transition_async(
                names[i],
                transition_id,
                lambda ok, j=i: step(j + 1, ok),
            )

        step(0, False)

    def _run_deactivate_chain(self, finished: Callable[[], None]) -> None:
        self._run_transition_chain(Transition.TRANSITION_DEACTIVATE, finished)

    def _run_shutdown_chain(self, finished: Callable[[], None]) -> None:
        # Jazzy exposes explicit shutdown transitions depending on current state.
        # Try the most appropriate transition first, but fall back if nodes are in
        # different lifecycle states (active/inactive/unconfigured).
        def try_unconfigured() -> None:
            self.get_logger().info("Nav2 shutdown: trying UNCONFIGURED_SHUTDOWN (fallback).")
            self._run_transition_chain(Transition.TRANSITION_UNCONFIGURED_SHUTDOWN, finished)

        def try_inactive() -> None:
            self.get_logger().info("Nav2 shutdown: trying INACTIVE_SHUTDOWN.")
            self._run_transition_chain(
                Transition.TRANSITION_INACTIVE_SHUTDOWN,
                try_unconfigured,
            )

        self.get_logger().info("Nav2 shutdown: trying ACTIVE_SHUTDOWN.")
        self._run_transition_chain(Transition.TRANSITION_ACTIVE_SHUTDOWN, try_inactive)

    def _run_nav2_game_over(self, finished: Callable[[], None]) -> None:
        # Root kill-switch: ask Nav2 lifecycle manager to shut down all managed nodes.
        # This is more reliable than poking each node's /change_state directly.
        self.get_logger().info("Nav2 game-over: requesting shutdown via lifecycle manager...")
        self._shutdown_nav2_via_manager_async(lambda _ok: finished())

    def _deferred_arm_cb(self) -> None:
        if self._arm_timer is not None:
            self._arm_timer.cancel()
            self._arm_timer = None
        self._teleop_active = True
        self._pub_active.publish(Bool(data=True))
        self.get_logger().info("Teleop armed: forwarding /cmd_vel (move sticks).")

        def after_shutdown() -> None:
            self._mode_busy = False
            self._nav2_game_over = True
            self.get_logger().info("Nav2 shutdown pass finished (game over until Nav2 is relaunched).")

        if not self._nav2_game_over:
            self.get_logger().info("Start: making Nav2 game-over in background (deactivate -> shutdown).")
            # Stop motion immediately before shutting Nav2 down (especially if it is
            # currently driving toward a goal).
            self._pub_cmd.publish(Twist())
            self._run_nav2_game_over(after_shutdown)
        else:
            self.get_logger().info("Start: Nav2 already shut down; teleop remains armed.")

    def _deferred_disarm_cb(self) -> None:
        if self._disarm_timer is not None:
            self._disarm_timer.cancel()
            self._disarm_timer = None
        self._mode_busy = False

    def _set_teleop_active(self, active: bool) -> None:
        if active:
            if self._mode_busy:
                return
            if self._teleop_active:
                return
            self._mode_busy = True
            self.get_logger().info("Start: scheduling teleop arm (non-blocking).")
            self._arm_timer = self.create_timer(0.001, self._deferred_arm_cb, callback_group=self._cbg)
        else:
            if self._arm_timer is not None:
                self._arm_timer.cancel()
                self._arm_timer = None
                self._mode_busy = False
            if not self._teleop_active:
                return
            self._mode_busy = True
            self.get_logger().info(
                "Back: disarming teleop. Nav2 will remain shut down until manually relaunched."
            )
            self._pub_cmd.publish(Twist())
            self._teleop_active = False
            self._pub_active.publish(Bool(data=False))
            self._disarm_timer = self.create_timer(0.001, self._deferred_disarm_cb, callback_group=self._cbg)

    def _on_joy(self, msg: Joy) -> None:
        n = len(msg.buttons)
        if self._start_i >= n or self._back_i >= n:
            return
        st = bool(msg.buttons[self._start_i])
        bk = bool(msg.buttons[self._back_i])

        if st and not self._prev_start:
            self._set_teleop_active(True)
        if bk and not self._prev_back:
            self._set_teleop_active(False)

        self._prev_start = st
        self._prev_back = bk

    def _on_twist(self, msg: Twist) -> None:
        if self._teleop_active:
            self._pub_cmd.publish(msg)

    def _srv_arm(
        self, _request: Trigger.Request, response: Trigger.Response
    ) -> Trigger.Response:
        self._set_teleop_active(True)
        response.success = True
        response.message = "teleop arming (Nav2 shutdown runs in background; game over until relaunched)"
        return response

    def _srv_disarm(
        self, _request: Trigger.Request, response: Trigger.Response
    ) -> Trigger.Response:
        self._set_teleop_active(False)
        response.success = True
        response.message = "teleop disarmed (Nav2 remains shut down until manually relaunched)"
        return response


def main(args: list[str] | None = None) -> None:
    rclpy.init(args=args)
    node = TeleopNavGate()
    executor = MultiThreadedExecutor(num_threads=4)
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        executor.shutdown()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
