<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macro: generic camera with parametric pose and naming -->
  <xacro:macro name="camera_module" params="
      parent_link
      cam_name:=camera
      xyz:='0 0 0'
      rpy:='0 0 0'
      radius:=0.05
      length:=0.04
      fov:=1.089
      width:=640
      height:=480
      clip_near:=0.05
      clip_far:=8.0
  ">

    <!-- BASE JOINT -->
    <joint name="${cam_name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${cam_name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- CAMERA BODY LINK -->
    <link name="${cam_name}_link">
      <visual>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 -1.57079632679 0"/>
        <material name="green"/>
      </visual>
    </link>

    <!-- OPTICAL FRAME -->
    <joint name="${cam_name}_optical_joint" type="fixed">
      <parent link="${cam_name}_link"/>
      <child link="${cam_name}_link_optical"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <link name="${cam_name}_link_optical"/>

    <!-- GAZEBO SENSOR -->
    <gazebo reference="${cam_name}_link">
      <sensor name="${cam_name}" type="camera">
        <camera>
          <camera_info_topic>${cam_name}/camera_info</camera_info_topic>
          <horizontal_fov>${fov}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>${width}</width>
            <height>${height}</height>
          </image>
          <clip>
            <near>${clip_near}</near>
            <far>${clip_far}</far>
          </clip>
        </camera>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <topic>${cam_name}/image_raw</topic>
        <gz_frame_id>${cam_name}_link_optical</gz_frame_id>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
