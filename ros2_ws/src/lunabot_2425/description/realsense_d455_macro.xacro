<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="realsense_camera" params="parent_link">

    <link name="depth_camera_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.04"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.05 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Fixed joint connecting camera to robot -->
    <joint name="depth_camera_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="depth_camera_link"/>
      <origin xyz="0.3 0.1 0.65" rpy="0 0.262 0"/>
    </joint>

    <!-- ===== Optical frames for ROS conventions ===== -->
    <!-- Color optical frame (rotated for camera coordinate system: Z forward, X right, Y down) -->
    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="camera_color_optical_frame"/>
      <!-- Rotation: -90 deg roll, 0 pitch, -90 deg yaw transforms robot frame to optical frame -->
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- Depth optical frame (same orientation as color for aligned depth) -->
    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- Camera link (standard ROS naming convention) -->
    <link name="camera_link"/>
    <joint name="camera_link_joint" type="fixed">
      <parent link="depth_camera_link"/>
      <child link="camera_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ======================================================= -->
    <!-- ================= GAZEBO HARMONIC SENSORS ============= -->
    <!-- ======================================================= -->
    <gazebo reference="depth_camera_link">

      <!-- ================= RGB CAMERA ================= -->
      <sensor name="d455_rgb_camera" type="camera">
        <topic>/sim/camera/rgb/image</topic>

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <pose>0 0 0 0 0 0</pose>

        <camera>
          <!-- D455 RGB: 86deg H-FOV = 1.5009 rad -->
          <horizontal_fov>1.5009</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>10.0</far></clip>
          <render_engine>ogre</render_engine>
        </camera>

        <frame>camera_color_optical_frame</frame>
      </sensor>

      <!-- ================= DEPTH CAMERA ================= -->
      <sensor name="d455_depth_camera" type="depth">
        <topic>/sim/camera/depth/image</topic>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <!-- D455 Depth: 86deg H-FOV = 1.5009 rad -->
          <horizontal_fov>1.5009</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.2</near><far>10.0</far></clip>
          <render_engine>ogre</render_engine>
        </camera>

        <!-- Optional: packed depth for pointcloud conversion -->
        <publisher>
          <topic>/sim/camera/depth/image_packed</topic>
          <type>pointcloud_packed</type>
        </publisher>

        <frame>camera_depth_optical_frame</frame>
      </sensor>

    </gazebo>

  </xacro:macro>

</robot>
