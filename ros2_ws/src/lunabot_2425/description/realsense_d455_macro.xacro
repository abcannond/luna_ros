<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="realsense_camera" params="parent_link">

    <link name="camera_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.04"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.05 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>


    <!-- Fixed joint connecting camera to robot -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="camera_link"/>
      <origin xyz="0.1 0 0.65" rpy="0 1 0"/>
    </joint>

    <!-- ======================================================= -->
    <!-- ================= GAZEBO HARMONIC SENSORS ============= -->
    <!-- ======================================================= -->
    <gazebo reference="camera_link">

      <!-- ================= RGB CAMERA ================= -->
      <sensor name="d455_rgb_camera" type="camera">
        <!-- Internal Gazebo topic -->
        <topic>/sim/camera/rgb/image</topic>

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <pose>0 0 0 0 0 0</pose>

        <camera>
          <horizontal_fov>1.0467</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>20.0</far></clip>
          <render_engine>ogre</render_engine>
        </camera>

        <frame>camera_color_optical_frame</frame>
      </sensor>

      <!-- ================= DEPTH CAMERA ================= -->
      <sensor name="d455_depth_camera" type="depth">
        <!-- Internal Gazebo topics -->
        <topic>/sim/camera/depth/image</topic>

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <pose>0 0 0 0 0 0</pose>

        <camera>
          <horizontal_fov>1.0467</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format> <!-- Depth format for bridge -->
          </image>
          <clip><near>0.1</near><far>20.0</far></clip>
          <render_engine>ogre</render_engine>
        </camera>

        <!-- Optional: packed depth for pointcloud conversion -->
        <publisher>
          <topic>/sim/camera/depth/image_packed</topic>
          <type>pointcloud_packed</type>
        </publisher>

        <frame>camera_depth_optical_frame</frame>
      </sensor>

    </gazebo>

  </xacro:macro>

</robot>
