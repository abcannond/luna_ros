<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="realsense_camera" params="parent_link">

    <!-- Camera link -->
    <link name="camera_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.04"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.05 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Fixed joint connecting camera to robot -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="camera_link"/>
      <origin xyz="0.1 0 0.2" rpy="0 0 0"/>
    </joint>

    <!-- RGB Camera -->
    <gazebo reference="camera_link">
      <sensor type="camera" name="d455_rgb_camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.0467</horizontal_fov> <!-- 60 degrees -->
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="gazebo_ros_camera_rgb" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera/rgb</namespace>
            <remapping>image:=image_raw</remapping>
          </ros>
          <camera_name>d455_rgb</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Depth Camera -->
    <gazebo reference="camera_link">
      <sensor type="depth" name="d455_depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.0467</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="gazebo_ros_depth_camera" filename="libgazebo_ros_depth_camera.so">
          <ros>
            <namespace>/camera/depth</namespace>
            <remapping>depth/image_raw:=depth_image</remapping>
          </ros>
          <camera_name>d455_depth</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
